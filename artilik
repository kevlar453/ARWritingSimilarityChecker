#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="$SCRIPT_DIR/.venv/bin/python"

if [ ! -f "$PYTHON_BIN" ]; then
    echo "[!] Virtual environment (.venv) tidak ditemukan."
    exit 1
fi

case "$1" in
    benchmark)
        shift
        exec "$PYTHON_BIN" -m benchmark.runner "$@"
        ;;
    worker)
        shift
        exec "$PYTHON_BIN" -m worker.worker "$@"
        ;;
    test)
        shift
        exec "$PYTHON_BIN" -m pytest -v tests/ "$@"
        ;;
    sanity)
        shift
        exec "$PYTHON_BIN" benchmark/sanity.py "$@"
        ;;
    diagnose)
        shift
        exec "$PYTHON_BIN" -m benchmark.diagnose "$@"
        ;;
    regression)
        shift
        exec "$PYTHON_BIN" tests/e2e_pipeline_test.py "$@"
        ;;
    readiness)
        shift
        exec "$PYTHON_BIN" tests/test_production_readiness.py "$@"
        ;;
    metrics)
        shift
        exec "$PYTHON_BIN" -m worker.metrics "$@"
        ;;
    observability)
        shift
        exec "$PYTHON_BIN" worker/observability.py "$@"
        ;;
    quality)
        shift
        exec "$PYTHON_BIN" worker/observability.py --quality "$@"
        ;;
    pilot-sample)
        shift
        exec "$PYTHON_BIN" evaluation/pilot_sampler_r2.py "$@"
        ;;
    export)
        shift
        exec "$PYTHON_BIN" -m worker.exporter "$@"
        ;;
    eval)
        shift
        exec "$PYTHON_BIN" -m evaluation.cli "$@"
        ;;
    notify)
        shift
        exec "$PYTHON_BIN" -m worker.telegram_notifier "$@"
        ;;
    corpus:import)
        shift
        exec "$PYTHON_BIN" -m worker.corpus_harvester "$@"
        ;;
    corpus:dropzone)
        shift
        exec "$PYTHON_BIN" -m worker.corpus_harvester --dropzone "$@"
        ;;
    corpus:harvest)
        shift
        exec "$PYTHON_BIN" -m worker.oai_harvester "$@"
        ;;
    corpus:cron)
        shift
        exec "$PYTHON_BIN" -m worker.scheduler_cron "$@"
        ;;
    corpus:enroll)
        shift
        exec "$PYTHON_BIN" -m worker.corpus_harvester --enroll "$@"
        ;;
    corpus:discover)
        shift
        exec "$PYTHON_BIN" -m worker.auto_discovery_harvester "$@"
        ;;
    corpus:jit)
        shift
        exec "$PYTHON_BIN" -m worker.jit_harvester "$@"
        ;;
    risk:train)
        shift
        exec "$PYTHON_BIN" -m worker.risk_classifier --train "$@"
        ;;
    risk:predict)
        shift
        exec "$PYTHON_BIN" -m worker.risk_classifier "$@"
        ;;
    ojs:pdf)
        shift
        exec "$PYTHON_BIN" worker/generate_ojs_pdf.py "$@"
        ;;
    *)
        echo "============================================="
        echo "        AR Tilik CLI Management Tool         "
        echo "============================================="
        echo "Penggunaan praktis:"
        echo "  ./artilik corpus:jit --title \"<judul>\"      # Temukan & indeks korpus sebidang Just-In-Time"
        echo "  ./artilik risk:train                        # Latih model XGBoost Academic Risk Synthesizer"
        echo "  ./artilik risk:predict                      # Uji inferensi model XGBoost Academic Risk"
        echo "  ./artilik corpus:discover --query \"<topik>\" # Cari & indeks karya ilmiah otomatis via OpenAlex"
        echo "  ./artilik corpus:discover --registry        # Panen otomatis dari katalog repositori kampus RI"
        echo "  ./artilik corpus:dropzone                   # Memproses semua file dalam storage/corpus_dropzone/"
        echo "  ./artilik corpus:import <file|dir>          # Impor naskah/folder/ZIP ke korpus institusi"
        echo "  ./artilik corpus:harvest --url <oai_url>    # Panen dari repositori kampus (EPrints/DSpace/OJS)"
        echo "  ./artilik corpus:cron                       # Jalankan siklus panen otomatis (dropzone + OAI)"
        echo "  ./artilik corpus:enroll <doc_id>            # Promosikan submission ke korpus institusi"
        echo "  ./artilik eval [generate|run|review]"
        echo "  ./artilik benchmark --engine [hybrid|tfidf|idf|exact]"
        echo "  ./artilik regression [--cleanup]"
        echo "  ./artilik readiness"
        echo "  ./artilik metrics"
        echo "  ./artilik observability [--benchmark]"
        echo "  ./artilik quality [--json]"
        echo "  ./artilik pilot-sample [--dry-run] [--target-per-tier 5]"
        echo "  ./artilik export --report <id> [--output <file.pdf>]"
        echo "  ./artilik notify \"Pesan notifikasi Telegram\""
        echo "  ./artilik test"
        echo "  ./artilik diagnose --run <id> --case <TC-XXX> [--engine <hybrid|exact|tfidf>]"
        echo "  ./artilik worker [--once]"
        echo "  ./artilik sanity [run_id]"
        echo ""
        echo "Atau aktifkan virtualenv secara manual:"
        echo "  source .venv/bin/activate"
        echo "  python -m benchmark.runner --engine hybrid"
        ;;
esac
