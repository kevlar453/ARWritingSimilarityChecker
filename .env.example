#--------------------------------------------------------------------
# AR Tilik - Environment Configuration Template
# Salin file ini menjadi .env dan sesuaikan kredensial lokal Anda:
# cp .env.example .env
#--------------------------------------------------------------------

# ENVIRONMENT
CI_ENVIRONMENT = development

# APP
app.baseURL = 'http://localhost:8085/'

# DATABASE (CodeIgniter 4)
database.default.hostname = 127.0.0.1
database.default.database = db_artilik
database.default.username = your_db_user
database.default.password = your_db_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# PYTHON WORKER ENVIRONMENT
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_USER = your_db_user
DB_PASSWORD = your_db_password
DB_NAME = db_artilik

# TELEGRAM BOT ALERTS
TELEGRAM_BOT_TOKEN = your_telegram_bot_token
TELEGRAM_CHAT_ID = your_telegram_chat_id

# AUTOMATED CORPUS HARVESTER
CORPUS_OAI_URL = 'https://repository.usd.ac.id/cgi/oai2'
CORPUS_OAI_LIMIT = 15
CORPUS_OAI_FULLTEXT = true
CORPUS_DISCOVERY_TOPICS = 'pendidikan,kesehatan,keselamatan kerja,manajemen,teologi,teknik,komputer'
OPENALEX_MAILTO = 'admin@tilik.arsetontong.top'
