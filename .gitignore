# Environment & Secrets
.env
.env.*
!.env.example

# Python
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# PHP / Composer
vendor/
composer.phar

# CodeIgniter 4 Writable Directory
writable/cache/*
writable/debugbar/*
writable/logs/*
writable/session/*
writable/uploads/*
writable/documents/*
!writable/cache/.gitkeep
!writable/debugbar/.gitkeep
!writable/logs/.gitkeep
!writable/session/.gitkeep
!writable/uploads/.gitkeep
!writable/documents/.gitkeep
!writable/.gitkeep

# Storage
storage/*
!storage/index.html
!storage/.gitkeep

# IDE & OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db

# Temporary scratchpad & dumps
tmp/
*.tmp
*.rdb
dump.rdb
